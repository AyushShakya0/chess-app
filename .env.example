# ==========================================
# VibeChess - Environment Configuration
# ==========================================

# 1. Google AI Studio (Gemini API)
# Powering AI character bots (Hikaru, Magnus, Hustler, Noob) banter & coaching
# Free tier key from: https://aistudio.google.com/
GOOGLE_AI_STUDIO_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase (Database, Auth, Realtime)
# Project credentials from: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 3. Boss Mode Challenge Dispatch (Optional)
# If set, challenges to Ayush Shakya trigger automated alert emails
# Free tier key from: https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here

# 4. Realtime Go Game Server (Optional)
# High-concurrency WebSocket engine hub for multiplayer rooms
NEXT_PUBLIC_GO_WS_SERVER_URL=ws://localhost:8080
